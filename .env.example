# portico environment surface — copy to .env and fill in.
# Never commit real keys. Key material belongs in the near-cli keychain or the
# relayer process environment, not in this file.

NODE_ENV=development
LOG_LEVEL=info

# --- NEAR network -----------------------------------------------------------
# Public testnet RPC; replace with a dedicated endpoint under load.
PORTICO_RPC_URL=https://test.rpc.fastnear.com
# CAIP-2 network identifier used by x402 v2.
PORTICO_NETWORK=near:testnet

# --- Deployed contracts -----------------------------------------------------
# Revenue-split contract (NEP-141 receiver, registry, streams, ledger).
PORTICO_SPLIT_CONTRACT=split.portico.testnet
# Payment FT, 18 decimals; the relayer asserts ft_metadata().decimals == 18 at boot.
PORTICO_TOKEN_CONTRACT=token.portico.testnet
# FT decimals pinned by the scheme implementation. Must stay 18.
PORTICO_EXPECTED_DECIMALS=18

# --- Relayer ----------------------------------------------------------------
# Account that pays gas and the 1-yocto attached deposit for delegated transfers.
PORTICO_RELAYER_ID=relayer.portico.testnet
# JSON array of ed25519 secret keys ("ed25519:...") for MultiKeySigner rotation.
PORTICO_RELAYER_SECRET_KEYS=["ed25519:REPLACE_ME"]

# --- Split configuration ----------------------------------------------------
# Platform fee recipient (also the contract owner at deploy time).
PORTICO_PLATFORM_WALLET=portico.testnet
# 0..=5000 basis points; 2000 = 20% platform / 80% developer.
PORTICO_FEE_BPS=2000

# --- Facilitator ------------------------------------------------------------
PORTICO_FACILITATOR_PORT=3002
HOST=0.0.0.0
FACILITATOR_URL=http://localhost:3002
# x402 timeout mapping: 1 block is treated as 1 second.
PORTICO_MAX_TIMEOUT_SECONDS=60
# Duplicate-settlement safety net; entries also evict at delegate max_block_height.
PORTICO_SETTLEMENT_CACHE_TTL_MS=120000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Comma-separated browser origins allowed to read PAYMENT-* headers.
PORTICO_ALLOWED_ORIGINS=http://localhost:3000

# --- Deploy / demo accounts (testnet only) ----------------------------------
PORTICO_DEPLOYER_ACCOUNT=portico.testnet
PORTICO_BUYER_ACCOUNT=buyer1.portico.testnet
PORTICO_DEV_ACCOUNT=dev1.portico.testnet
# Raw-unit amounts for the self-deployed FT (18 decimals).
PORTICO_FT_TOTAL_SUPPLY=1000000000000000000000000000
PORTICO_FT_SEED_AMOUNT=1000000000000000000000000
# NEP-145 registration deposit per demo account, in NEAR.
PORTICO_STORAGE_DEPOSIT_NEAR=0.01
