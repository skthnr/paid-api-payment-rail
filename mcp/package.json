{
  "name": "@portico/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "portico stdio MCP server exposing x402 v2 NEAR payment tools to agents",
  "type": "module",
  "main": "dist/mcp-server.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/mcp-server.ts",
    "dev": "tsx src/mcp-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@portico/sdk": "workspace:*",
    "near-api-js": "7.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
