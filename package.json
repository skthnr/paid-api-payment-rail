{
  "name": "@portico/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "portico — x402 v2 NEAR exact scheme with a NEP-141 revenue-split contract, NEP-366 relayer and public ledger",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.4.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:ft": "tsx scripts/deploy-ft.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "dotenv": "^16.3.1",
    "typescript": "~5.7.2"
  }
}
