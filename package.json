{
  "name": "@portico/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "portico — x402 v2 NEAR exact scheme with a NEP-141 revenue-split contract, NEP-366 relayer and public ledger",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:ft": "tsx scripts/deploy-ft.ts",
    "demo": "tsx scripts/demo.ts",
    "sandbox:demo": "tsx scripts/sandbox-demo.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "globals": "^17.5.0",
    "near-api-js": "7.5.3",
    "near-sandbox": "0.3.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
